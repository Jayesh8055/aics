# Convert new emails to numerical features
emails = [
    'Upto 20% discount on parking, exclusive offer just for you. Dont miss this reward!',
    'Hey mohan, can we get together to watch football game tomorrow?'
]

# Transform the emails using the same vectorizer
emails_count = vectorizer.transform(emails)

# Predict using the trained Naive Bayes model
predictions = model.predict(emails_count)

# Print predictions (1 = Spam, 0 = Not Spam)
for email, prediction in zip(emails, predictions):
    label = "Spam" if prediction == 1 else "Not Spam"
    print(f"Email: {email}\nPrediction: {label}\n")
